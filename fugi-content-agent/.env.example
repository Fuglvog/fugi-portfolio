# Required for COPY task (caption generation via Claude API)
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Required for ART task (image generation) and VIDEO task (video generation)
# via fal.ai. Only consumed when --media image|video is passed to the
# orchestrator; caption-only runs do not need this.
# Get one at https://fal.ai/dashboard/keys
FAL_KEY=
